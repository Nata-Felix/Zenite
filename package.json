{
  "name": "zenite",
  "productName": "Zênite",
  "version": "0.30.1",
  "private": true,
  "description": "Canvas infinito para terminais e agentes de IA.",
  "license": "Apache-2.0",
  "main": "out/main/index.js",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --external:original-fs --external:@lydell/node-pty --outfile=out/main/index.js",
    "build:preload": "esbuild src/preload/index.ts src/preload/webview.ts src/preload/browser.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outdir=out/preload",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=out/cli/index.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:cli && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-unit.mjs",
    "test:unit": "node tests/run-unit.mjs",
    "test:e2e": "npm run build && node tests/run-e2e.mjs",
    "test:docker": "npm run build && node tests/docker/isolated-headless.check.cjs",
    "security:check": "node scripts/security/check-public-files.mjs",
    "test:live": "node tests/live/sol-agents.live.cjs",
    "test:round-elements": "npm run build && electron tests/e2e/round-elements.check.cjs --real-app",
    "test:flow-astros": "npm run build && electron tests/e2e/flow-astros.check.cjs",
    "test:flow-actions": "npm run build && electron tests/e2e/flow-actions.check.cjs",
    "test:chronos": "npm run build && electron tests/e2e/chronos.check.cjs",
    "test:sol-canvas-welcome": "npm run build && electron tests/e2e/sol-canvas-welcome.check.cjs",
    "prepare:isolation": "node scripts/isolation/prepare-isolation.cjs",
    "test:isolation": "npm run build && electron tests/e2e/isolated-runtime.check.cjs",
    "test:integrations": "npm run build && electron tests/e2e/canvas-integrations.check.cjs",
    "test:galaxy-archive": "npm run build && electron tests/e2e/galaxy-archive.check.cjs",
    "test:black-holes": "npm run build && electron tests/e2e/black-holes.check.cjs",
    "test:ui": "npm run build && electron tests/e2e/node-options.check.cjs && electron tests/e2e/canvas-clipboard.check.cjs && electron tests/e2e/canvas-undo.check.cjs && electron tests/e2e/canvas-sol.check.cjs --visible && electron tests/e2e/web-devtools.check.cjs && electron tests/e2e/terminal-mouse.check.cjs && electron tests/e2e/terminal-mouse.check.cjs --screen=1080p && electron tests/e2e/connection-effects.check.cjs && electron tests/e2e/round-elements.check.cjs --real-app && electron tests/e2e/canvas-security.check.cjs && electron tests/e2e/canvas-integrations.check.cjs",
    "dist:win": "npm run build && node scripts/build/prepare-win.mjs && electron-builder --win nsis --x64 --publish never && node scripts/build/pack-app-update.mjs && node scripts/build/build-installer-ui.mjs",
    "release:win": "npm run build && node scripts/build/prepare-win.mjs && electron-builder --win nsis --x64 --publish never && node scripts/build/pack-app-update.mjs && node scripts/build/build-installer-ui.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@fontsource/caveat": "5.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "dompurify": "3.4.16",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-react": "1.52.0",
    "marked": "18.0.14",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "roughjs": "4.6.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "build": {
    "appId": "app.zenite",
    "productName": "Zênite",
    "executableName": "Zenite",
    "copyright": "Apache-2.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "out/cli/**",
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "!node_modules/@lydell/node-pty-{darwin,linux}-*/**"
    ],
    "asarUnpack": [
      "out/cli/**",
      "node_modules/@lydell/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zênite",
      "uninstallDisplayName": "Zênite",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "Zenite-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Nata-Felix",
        "repo": "O",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ]
  }
}
